APP_NAME="Job Digger Admin"
APP_ENV=local
# Laravel 內部加密用 (AES-256-CBC),必須是 base64:<32-byte> 格式
# 用 `php artisan key:generate` 產生
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei
APP_URL=http://localhost:8084

# Middle Platform (IdP) 對外 URL,使用者沒登入時會被導去這裡
MIDDLE_PLATFORM_URL=http://localhost

# SSO JWT 共享密鑰 (HS256),必須跟中台 DJANGO_SECRET_KEY 完全一致
# 跟 APP_KEY 分開:APP_KEY 是 Laravel AES-256-CBC 用,SSO_JWT_SECRET 是 HS256 共用密鑰
SSO_JWT_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 連到 job-digger 提供的 PostgreSQL(container 內透過 host.docker.internal:5434)
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5434
DB_DATABASE=job_digger
DB_USERNAME=developer
DB_PASSWORD=change-me

# 用 file/sync 避免汙染 job-digger 共用的 DB(本系統不擁有 sessions/cache/jobs 表)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# job-digger Python API (FastAPI on host port 85)
# - JOB_DIGGER_API_URL: 給瀏覽器用(host POV)
# - JOB_DIGGER_INTERNAL_URL: 給後端 PHP 用(scheduler / LLM 轉發)
#   雲端兩者通常同一個 Cloud Run URL,只設 API_URL 即可
JOB_DIGGER_API_URL=http://localhost:85
JOB_DIGGER_INTERNAL_URL=http://host.docker.internal:85
