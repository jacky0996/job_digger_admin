APP_NAME="Job Digger Admin"
APP_ENV=local
# Laravel 內部加密用 (AES-256-CBC,要求 base64:32-byte)。跟 SSO 完全無關。
APP_KEY=base64:ZfH/pmpgr0yMFtXCvOH12X7+tYFRISaeBaVR5lPnbVk=
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei
APP_URL=http://localhost:8084

# Middle Platform (IdP) 對外 URL — 瀏覽器看到的 URL,所以 host POV
MIDDLE_PLATFORM_URL=http://localhost
# SSO JWT 共享密鑰 (HS256),必須跟中台 DJANGO_SECRET_KEY 完全一致
SSO_JWT_SECRET=dev-secret-key-please-change-in-production-0123456789abcdef

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 從 docker container 內走 host.docker.internal 連到 host 上 job-digger 的 PostgreSQL :5434
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5434
DB_DATABASE=job_digger
DB_USERNAME=digger_user
DB_PASSWORD=digger_pass_456

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# job-digger Python API (FastAPI on host port 85)
JOB_DIGGER_API_URL=http://localhost:85

GEMINI_API_KEY = 'AIzaSyDhLt7lDZHG9gfCW73S39qKuhzcugvwkLE'
